package components

templ Layout991(title string, sidebar bool) {
	<!DOCTYPE html>
	<html>
		<head>
			<title>{title}</title>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
		</head>
		<body>
			@Header991(title)
			<main class="main-content">
				if sidebar {
					<div class="layout-with-sidebar">
						<aside class="sidebar">
							@Sidebar991()
						</aside>
						<div class="content">
							{ children... }
						</div>
					</div>
				} else {
					<div class="content-full">
						{ children... }
					</div>
				}
			</main>
			@Footer991()
		</body>
	</html>
}

templ Header991(title string) {
	<header class="header">
		<nav class="navbar">
			<div class="navbar-brand">
				<a href="/">{title}</a>
			</div>
			<div class="navbar-nav">
				<a href="/dashboard">Dashboard</a>
				<a href="/projects">Projects</a>
				<a href="/settings">Settings</a>
			</div>
		</nav>
	</header>
}

templ Sidebar991() {
	<nav class="sidebar-nav">
		<ul class="nav-list">
			<li><a href="/dashboard" class="nav-link">Dashboard</a></li>
			<li><a href="/projects" class="nav-link">Projects</a></li>
			<li class="nav-group">
				<span class="nav-group-title">Components</span>
				<ul class="nav-sublist">
					<li><a href="/components/buttons" class="nav-link">Buttons</a></li>
					<li><a href="/components/forms" class="nav-link">Forms</a></li>
					<li><a href="/components/cards" class="nav-link">Cards</a></li>
				</ul>
			</li>
		</ul>
	</nav>
}

templ Footer991() {
	<footer class="footer">
		<div class="footer-content">
			<p>&copy; 2024 Templar Framework. All rights reserved.</p>
		</div>
	</footer>
}
