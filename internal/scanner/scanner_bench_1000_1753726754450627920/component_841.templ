package components

import "fmt"

templ Card841(title string, content string, actions []string) {
	<div class="card">
		<div class="card-header">
			<h3>{title}</h3>
		</div>
		<div class="card-body">
			<p>{content}</p>
		</div>
		<div class="card-footer">
			for _, action := range actions {
				<button class="btn">{action}</button>
			}
		</div>
	</div>
}

templ CardSimple841(title string) {
	<div class="simple-card">{title}</div>
}
